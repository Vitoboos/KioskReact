{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "cartelera-app",
  "version": "0.1.0",
  "identifier": "com.rolda.kiosko",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "devtools": true,
        "title": "Cartelera Interactiva",
        "width": 2160,
        "height": 3840,
        "fullscreen": true,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}